{
  "name": "tracereview",
  "displayName": "TraceReview",
  "publisher": "Saksham",
  "description": "To generate report automatically on the basis of you marked lines",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.2"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tracereview.generateReport",
        "title": "TraceReview: Generate Report"
      },
      {
        "command": "tracereview.openFinding",
        "title": "TraceReview: Open Finding"
      },
      {
        "command": "tracereview.addFinding",
        "title": "TraceReview: Add Review Finding"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tracereview.addFinding",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tracereview",
          "title": "TraceReview",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "tracereview": [
        {
          "id": "tracereview.findingsView",
          "name": "Review Findings"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
